# ==========================================
# EVERYPOSTING - SECURE PRODUCTION .GITIGNORE
# ==========================================

# 1. DEPENDENCIES & PACKAGES
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
.env*.local
.env.example.local

# 3. PRIVATE KEYS, CERTIFICATES & CREDENTIALS
*.pem
*.key
*.p12
*.pfx
*.asc
id_rsa
id_ed25519
*.crt
credentials.json
service-account.json

# 4. NEXT.JS BUILD & TURBOPACK CACHE
/.next/
/out/
/build/
/dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# 5. VERCEL & DEPLOYMENT CACHE
.vercel

# 6. SUPABASE LOCAL & CREDENTIALS
.supabase/

# 7. LOGS & DIAGNOSTICS
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# 8. TESTING & COVERAGE
/coverage
/.nyc_output

# 9. OS SYSTEM & IDE TEMP FILES
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 10. EDITOR & IDE CONFIGURATIONS
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 11. SCRATCH & TEMPORARY FILES
tmp/
temp/
scratch/
